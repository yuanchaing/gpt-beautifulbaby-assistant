{
  "rewrites": [
    { "source": "/webhook", "destination": "/api/webhook" },
    { "source": "/healthz", "destination": "/api/healthz" },
    { "source": "/_diag", "destination": "/api/_diag" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/", "destination": "/api" }
  ],
  "functions": { "api/**/*": { "maxDuration": 10 } }
}
